{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/api/eventos-admin", "destination": "/api/eventos?rota=admin" },
    { "source": "/api/eventos-coletar", "destination": "/api/eventos?rota=coletar-sao-joao" },
    { "source": "/app", "destination": "/app.html" },
    { "source": "/app/(.*)", "destination": "/app.html" },
    { "source": "/dashboard", "destination": "/dashboard.html" },
    { "source": "/maringa", "destination": "/maringa.html" },
    { "source": "/londrina", "destination": "/londrina.html" },
    { "source": "/indaiatuba", "destination": "/indaiatuba.html" },
    { "source": "/saojoao", "destination": "/saojoao.html" }
  ]
}
